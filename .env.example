# Copy to .env for local development; do not commit the actual key.
# Configure the same variables in the deployed Nuxt server environment.
# Production analytics: ID alone does not enable collection. See docs/GA4.md.
NUXT_PUBLIC_GA4_MEASUREMENT_ID=G-6BQP2JS6MK
NUXT_PUBLIC_GA4_ENABLED=false
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Home preview only: enable Maps Static API and restrict this browser key to it.
# No automatic reuse of the JavaScript API key. Never put a URL signing secret here.
NUXT_PUBLIC_GOOGLE_STATIC_MAPS_API_KEY=
# Optional home-only Static Maps map ID; leave empty for Google's default map.
NUXT_PUBLIC_GOOGLE_STATIC_MAP_ID=8874d01a85c7c50d6fe5cae7
# Existing POPKU Web JavaScript map ID, associated with the published popku style.
# Separate from the home Static Maps map ID above.
NUXT_PUBLIC_GOOGLE_MAPS_MAP_ID=8874d01a85c7c50d28c8018f
# Optional server-only override; defaults to https://api.popchive.com.
NUXT_API_BASE=https://api.popchive.com
# Server-only Naver Search API credentials; missing values hide blog reviews.
NUXT_NAVER_CLIENT_ID=
NUXT_NAVER_CLIENT_SECRET=
